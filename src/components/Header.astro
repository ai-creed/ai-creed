---

---

<header class="site-header">
	<div class="container row">
		<a class="brand" href="/">
			<img class="mark" src="/brand-mark.png" alt="" width="20" height="20" />
			<span>ai-creed</span>
		</a>
		<nav class="links">
			<a href="/#products">projects</a>
			<span class="sep">·</span>
			<a href="/bio">bio</a>
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--border);
		padding: var(--s-3) 0;
		font-size: var(--fs-sm);
	}
	.row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--s-4);
	}
	.brand {
		display: inline-flex;
		gap: var(--s-2);
		align-items: center;
		border: none;
		color: var(--fg);
		min-height: 44px;
	}
	.brand:hover {
		color: var(--accent);
	}
	.mark {
		display: block;
	}
	.links {
		display: inline-flex;
		gap: var(--s-2);
		align-items: center;
		color: var(--fg-dim);
	}
	.links a {
		border: none;
		color: var(--fg-dim);
		min-height: 44px;
		min-width: 44px;
		display: inline-flex;
		align-items: center;
	}
	.links a:hover {
		color: var(--accent);
	}
	.sep {
		opacity: 0.5;
	}
</style>
